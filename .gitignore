.env
# Saved-page asset folders (page text is preserved in the .html itself)
archive/*_files/

# Lodgement copies of consultation submissions: held out of the public repo
# until the receiving committee/body authorises publication (Senate submission
# guidance: a received submission is a committee document; prior independent
# publication does not attract privilege). Commit only after authorisation.
submissions/LODGEMENT-*

# Filed submissions awaiting the receiving body's own publication decision.
# Australian parliamentary committees publish submissions on their schedule;
# publishing ours first would pre-empt that. Move a file up into submissions/
# and commit it once the committee has published.
submissions/pending/

# Confidential engagement material: NAIC session recordings/transcripts and
# prep notes derived from them, held locally at NAIC's request not to share
# publicly. Never commit. Public-safe findings go in case-studies/ or
# submissions/ only where independently supported by a public source.
local/
